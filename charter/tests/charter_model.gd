extends SceneTree
const Document=preload("res://document.gd")
const Vocab=preload("res://vocabulary.gd")
var failures=0
func check(ok: bool, text: String) -> void:
	if not ok: failures+=1; push_error(text)
	else: print("PASS ",text)
func _init() -> void:
	KB.set_layout("ansi")
	var d=Document.new()
	d.raw={"bpm":120,"offset":0,"timing":[{"t":0,"beat":0.5,"meter":4}],"lights":[{"t":0,"id":1,"type":"on","x":0.5,"w":0.8,"a":0,"auto":true}],"notes":[]}
	d.core.load_chart(d.raw)
	var rev=d.revision()
	check(d.edit({"expected_revision":"stale","ops":[]}).has("error"),"stale revision refused")
	var note={"t":3.0,"light":1,"u":0.5,"kind":"tap","dur":0,"k":5}
	var result=d.edit({"expected_revision":rev,"ops":[{"op":"add","value":note}]})
	check(not result.has("error"),"transparent live carrier accepts note")
	var after=d.revision()
	check(after!=rev,"revision changed")
	d.undo(); check(d.revision()==rev,"undo exact document")
	d.redo(); check(d.revision()==after,"redo exact document")
	check(d.edit({"expected_revision":after,"ops":[{"target":"lights","op":"delete","index":0}]}).has("error"),"orphan refused")
	check(d.revision()==after,"refusal atomic")
	check(d.edit({"expected_revision":after,"ops":[{"op":"add","value":{"t":1,"light":1,"u":0.5,"kind":"tap","dur":0,"k":5}}]}).has("error"),"insufficient approach refused")
	check(d.edit({"expected_revision":after,"ops":[{"op":"add","value":{"t":4,"light":1,"u":0.0,"kind":"tap","dur":0,"k":10}},{"target":"lights","op":"update","index":0,"value":{"w":0.1}}]}).has("error"),"uncovered key refuses entire batch")
	check(d.revision()==after,"multi-operation rollback")
	var boundary=d.edit({"expected_revision":after,"ops":[{"op":"add","value":{"t":1.3,"light":1,"u":0.5,"kind":"tap","dur":0,"k":5}}]})
	check(not boundary.has("error"),"SPEC 1.3-second approach boundary accepted")
	if not boundary.has("error"): d.undo()
	check(d.edit({"expected_revision":after,"ops":[{"target":"lights","op":"add","value":{"t":4,"id":1,"type":"off","auto":true}},{"target":"notes","op":"update","index":0,"value":{"kind":"hold","dur":2}}]}).has("error"),"hold end lifetime refused")
	check(absf(d.seconds("49.1+3/16")-98.375)<0.00001,"bar zero and whole-note fractions")
	check(d.position(-0.5).bar==-1,"pickup bar")
	check(is_nan(d.seconds("bad.1")) and is_nan(d.seconds("1.5")),"malformed musical positions refused")
	check(absf(d.seconds(d.position(3.123456).bar_beat)-3.123456)<0.000001,"arbitrary position text round trip")
	for ch in Vocab.data():
		for level in Vocab.data()[ch].levels:
			check(Vocab.value(ch,level.word)==level.value and Vocab.describe(ch,level.value).word==level.word,"vocabulary "+ch+" "+level.word)
	var dir="res://evidence/temp_song"
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(dir))
	var file=dir.path_join("chart.json")
	var f=FileAccess.open(file,FileAccess.WRITE); f.store_string(JSON.stringify(d.raw)); f.close()
	var e=Document.new(); e.open(file)
	var original=e.raw.duplicate(true)
	check(e.save().get("unchanged",false),"unedited save does not rewrite")
	check(e.save(true).has("error"),"MCP save requires user opt-in")
	e.edit({"expected_revision":e.revision(),"ops":[{"target":"meta","value":{"test":true}}]})
	check(not e.save().has("error"),"backup and save")
	var expected=e.raw.duplicate(true); e.open(file)
	check(e.raw==expected,"edit save reload equals")
	e.begin_group(); e.allow_save=true
	e.edit({"expected_revision":e.revision(),"ops":[{"target":"meta","value":{"test":true,"claude_save":true}}]},"Claude")
	check(not e.save(true).has("error"),"authorized MCP save works inside Claude turn")
	check(e.edit({"expected_revision":e.revision(),"ops":[]}).has("error"),"manual mutation blocked during Claude turn")
	e.end_group()
	check(ChartLib.validate(e.raw).warnings==ChartLib.validate(original).warnings,"saved chart game warnings unchanged")
	var source=ProjectSettings.globalize_path("res://evidence/protected/chart.json")
	DirAccess.make_dir_recursive_absolute(source.get_base_dir())
	DirAccess.copy_absolute(ProjectSettings.globalize_path("res://../game/tests/fixtures/dense/chart.json"), source)
	var marker=FileAccess.open(source.get_base_dir().path_join(".read-only"),FileAccess.WRITE); marker.close()
	var bytes=FileAccess.get_file_as_bytes(source)
	e.open(source); check(not e.raw.is_empty(),"original demo opens")
	check(e.save().has("error"),"source save protected")
	check(bytes==FileAccess.get_file_as_bytes(source),"original demo byte-identical after open/save attempt")
	print("CHARTER_MODEL failures=",failures)
	quit(1 if failures else 0)
