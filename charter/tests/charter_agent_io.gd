extends SceneTree
const Store = preload("res://attachments.gd")
const Tools = preload("res://tools.gd")
const Document = preload("res://document.gd")
var failures = 0
func _init() -> void: run.call_deferred()
func check(ok: bool, label: String) -> void:
	print("PASS " if ok else "FAIL ",label)
	if not ok: failures += 1
func run() -> void:
	AudioServer.set_bus_mute(0,true); KB.set_layout("ansi")
	var fixture = ProjectSettings.globalize_path("res://tests/fixtures/generated")
	var store = Store.new(); store.start()
	var row = store.attach(fixture.path_join("original.osz"))
	check(not row.has("error") and FileAccess.get_sha256(store.path(row)) == FileAccess.get_sha256(fixture.path_join("original.osz")),"attachment copy/hash preserves source")
	var api = Tools.new(); api.doc = Document.new(); api.attachments = store
	api.songs_root = ProjectSettings.globalize_path("res://../dist/agent-io/songs")
	DirAccess.make_dir_recursive_absolute(api.songs_root)
	check(api.call_tool("attachments_list",{}).attachments.size() == 1,"attachments_list without song")
	check(api.call_tool("attachment_read",{"id":row.id}).entries.size() == 4,"safe ZIP listing")
	check(api.call_tool("attachment_image",{"id":row.id,"entry":"bg.png"}).has("_mcp_content"),"attachment image")
	var parsed = api.call_tool("osu_parse",{"id":row.id})
	check(parsed.difficulties.size() == 2,"difficulty listing")
	for keys in [4,7]:
		var entry = "original-%dk.osu" % keys
		parsed = api.call_tool("osu_parse",{"id":row.id,"entry":entry,"limit":3})
		check(parsed.get("key_count",0) == keys and parsed.get("notes",[]).size() == 3 and parsed.summary.notes == 26 and parsed.timing_points[1].sv == 2 and parsed.timing_points[2].bpm == 150,"parse %dK timing/SV/paging" % keys)
		var created = api.call_tool("song_create",{"from_attachment":row.id,"osu_entry":entry,"dir":"agent_fixture"})
		check(not created.has("error") and not FileAccess.file_exists(api.songs_root.path_join("index.json")),"create unique library-only song: "+JSON.stringify(created))
		var opened = api.call_tool("song_open",{"dir":created.dir})
		check(not opened.has("error") and api.doc.raw.notes.is_empty() and api.doc.raw.timing.size() == 2,"open new song")
		var converted = api.call_tool("osu_convert_draft",{"id":row.id,"osu_entry":entry})
		check(not converted.has("error") and api.doc.raw.notes.size() == 26 and api.doc.undo_stack.size() == 1,"convert %dK as one undo step: " % keys+JSON.stringify(converted))
		check(api.doc.coverage(api.doc.raw).is_empty(),"draft no orphans")
		var complete = api.call_tool("osu_parse",{"id":row.id,"entry":entry,"limit":1000}); var accurate = true
		for index in complete.notes.size():
			var original_note = complete.notes[index]; var note = api.doc.raw.notes[index]
			accurate = accurate and absf(note.t-(original_note.t_ms/1000.0+2.0)) <= 0.001 and note.k == converted.mapping[original_note.column].k
			if original_note.get("end_ms",original_note.t_ms)-original_note.t_ms >= 80: accurate = accurate and note.kind == "hold" and absf(note.dur-(original_note.end_ms-original_note.t_ms)/1000.0) <= 0.001
		check(accurate,"every %dK note column/time and retained hold accurate within 1ms" % keys)
		check(absf(api.doc.raw.notes[0].t-3.0) <= 0.001 and api.doc.raw.notes[0].kind == "hold" and absf(api.doc.raw.notes[0].dur-0.2) <= 0.001 and api.doc.raw.notes[-1].kind == "tap","draft time/hold/min length")
		check(api.call_tool("song_open",{"dir":created.dir,"discard":true}).has("error"),"unsaved open refuses unconfirmed discard")
		api.doc.undo()
	var unsafe = store.attach(fixture.path_join("traversal.osz")); check(store.entries(unsafe.id).has("error"),"ZIP path traversal refused")
	var bomb = store.attach(fixture.path_join("bomb.osz")); check(store.entries(bomb.id).has("error"),"ZIP bomb preflight refused")
	var txt = store.attach(fixture.path_join("text.txt")); var page = store.read({"id":txt.id,"limit":65536})
	check(page.text.to_utf8_buffer().size() <= 65536 and not page.done,"text page capped")
	check(JSON.stringify(api.call_tool("chart_syntax",{})).to_utf8_buffer().size() < 12000,"syntax index bounded")
	for section in ["syntax","notes","judgement","camera","keyboard","warnings"]: check(not api.call_tool("chart_syntax",{"section":section}).has("error"),"syntax "+section)
	var importer = preload("res://osu_io.gd").new(); importer.api = api
	var original = FileAccess.get_file_as_string(fixture.path_join("original-4k.osu"))
	var unsupported = importer.parse_text(original.replace("Mode: 3","Mode: 0"))
	check(unsupported.has("error") and unsupported.mode == 0 and unsupported.has("metadata"),"unsupported mode retains metadata")
	check(importer.parse_text("bad").has("error") and importer.parse_text(original.replace("0,500,4","0,0,4")).has("error"),"malformed map and timing refused")
	check(api.call_tool("osu_parse",{"id":"missing"}).has("error") and api.call_tool("osu_parse",{"id":row.id,"entry":"missing.osu"}).has("error"),"osu_parse unknown attachment/entry")
	check(api.call_tool("attachment_image",{"id":txt.id}).has("error") and api.call_tool("attachment_read",{"id":row.id,"entry":"../escape"}).has("error"),"wrong image type and unsafe entry errors")
	check(api.call_tool("song_create",{"from_attachment":row.id,"osu_entry":"original-4k.osu","dir":"../escape"}).has("error") and api.call_tool("song_open",{"dir":"../escape"}).has("error"),"song create/open cannot escape library")
	check(api.call_tool("song_create",{"from_attachment":"missing"}).has("error") and api.call_tool("song_open",{"dir":"missing"}).has("error"),"song create/open missing input errors")
	check(api.call_tool("preview_frame",{"at":3}).has("error") and api.call_tool("chart_syntax",{"section":"missing"}).has("error"),"unavailable preview and invalid syntax section errors")
	var loose = store.attach(fixture.path_join("original-4k.osu"))
	check(api.call_tool("song_create",{"from_attachment":loose.id}).has("error"),"loose osu requires separately attached audio")
	store.attach(fixture.path_join("tone.wav"))
	var created_dirs = []
	for count in range(4,11):
		var text = original.replace("CircleSize: 4","CircleSize: "+str(count))
		var source = api.songs_root.path_join("keys-%d.osu" % count)
		var f = FileAccess.open(source,FileAccess.WRITE); f.store_string(text); f.close()
		var input = store.attach(source)
		var created = api.call_tool("song_create",{"from_attachment":input.id,"dir":"all_keys"})
		created_dirs.append(created.dir)
		check(not api.call_tool("song_open",{"dir":created.dir}).has("error"),"open %dK loose fixture" % count)
		var before = api.doc.revision()
		var wrong = api.call_tool("osu_convert_draft",{"id":input.id,"mapping":["D"]})
		check(wrong.has("error") and api.doc.revision() == before,"invalid mapping atomic %dK" % count)
		var converted = api.call_tool("osu_convert_draft",{"id":input.id})
		check(not converted.has("error") and converted.mapping.size() == count and api.doc.coverage(api.doc.raw).is_empty(),"default mapping covers %dK" % count)
		check(api.call_tool("osu_convert_draft",{"id":input.id}).has("error"),"draft cannot overwrite populated song %dK" % count)
		api.doc.undo()
	check(created_dirs.size() == 7 and created_dirs[0] != created_dirs[1],"song_create always chooses unique folder")
	var explicit = api.call_tool("osu_convert_draft",{"id":store.items[-1].id,"mapping":[{"key":"A","track":10},{"key":"S","track":10},{"key":"D","track":11},{"key":"F","track":11},{"key":"G","track":12},{"key":"H","track":12},{"key":"J","track":13},{"key":"K","track":13},{"key":"L","track":14},{"key":";","track":14}]})
	check(not explicit.has("error") and api.doc.raw.lights.size() == 5,"explicit column/key/track grouping")
	api.doc.undo()
	var large_ops = []
	for i in 3000: large_ops.append({"target":"notes","op":"add","value":{"t":3+i*0.125,"light":0,"u":0.5,"k":2,"kind":"tap"}})
	# Use a known full carrier and measure one validation/refresh, not one per operation.
	api.doc.raw = {"bpm":120,"offset":2,"lights":[{"t":0,"id":0,"type":"on","x":0.5,"w":1,"auto":true}],"notes":[],"fx":[]}; api.doc.refresh_core(); api.doc.undo_stack.clear()
	var started = Time.get_ticks_msec()
	var batch = api.call_tool("edit",{"expected_revision":api.doc.revision(),"ops":large_ops})
	check(not batch.has("error") and api.doc.raw.notes.size() == 3000 and api.doc.undo_stack.size() == 1,"3000 operations atomic in %dms" % (Time.get_ticks_msec()-started))
	var rev = api.doc.revision(); large_ops.append({"target":"notes","op":"add","value":{"t":-1}})
	check(api.call_tool("edit",{"expected_revision":rev,"ops":large_ops}).has("error") and api.doc.revision() == rev,"large batch failure rolls back")
	var oversized = api.songs_root.path_join("oversized.bin")
	var f = FileAccess.open(oversized,FileAccess.WRITE); f.seek(Store.MAX_FILE); f.store_8(1); f.close()
	check(store.attach(oversized).has("error"),"300MB per-file limit")
	DirAccess.remove_absolute(oversized)
	check(store.attach(fixture).has("error"),"directory attachment rejected")
	while store.items.size() < 20: store.attach(fixture.path_join("text.txt"))
	check(store.attach(fixture.path_join("text.txt")).has("error"),"20 attachments per conversation limit")
	var count_before = store.items.size(); var restored = Store.new(); restored.start(store.conversation_id)
	check(restored.items.size() == count_before,"attachment manifest restores conversation")
	store.remove(store.items[-1].id); check(store.items.size() == 19,"removable attachment chip storage")
	var old_folder = store.folder()
	store.delete_conversation()
	check(not DirAccess.dir_exists_absolute(old_folder),"conversation deletion cleans copied files")
	print("CHARTER_AGENT_IO failures=",failures); quit(1 if failures else 0)
